# Server Configuration
PORT=5000
NODE_ENV=development

# Database Mode (Set to true for local Docker PostgreSQL testing)
USE_LOCAL_DB=true
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hivelet_db

# Supabase Configuration
SUPABASE_URL=https://xeynbzcoywogcaesyhkw.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhleW5iemNveXdvZ2NhZXN5aGt3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUyMDg0MjksImV4cCI6MjEwMDc4NDQyOX0.8frGFwGxrTfW07kYFZ4_OBQc_VHyHybifTg8PA0cgSg
# Service-role key (Supabase Dashboard > Project Settings > API). Required by supabaseAdmin.ts for
# tenant onboarding and the Adyen webhook -- never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# JWT Security Credentials
JWT_SECRET=hivelet_super_secret_jwt_key_2026_capstone
JWT_EXPIRES_IN=7d

# Adyen GCash Payment Sandbox Credentials (Optional Feature, FR-015)
# ADYEN_API_KEY left as the shipped placeholder value means Adyen is treated as "not configured" --
# the /api/payments/adyen/session route returns a clear 503 instead of calling Adyen. Drop in real
# test-account credentials (https://docs.adyen.com/development-resources/test-cards) to activate it.
ADYEN_API_KEY=mock_adyen_api_key_sandbox
ADYEN_MERCHANT_ACCOUNT=HiveletECom
ADYEN_ENVIRONMENT=TEST
# Client-side (public) key from the same Adyen Customer Area, used by the Drop-in component.
ADYEN_CLIENT_KEY=
# HMAC key configured on the webhook in the Adyen Customer Area -- verifies webhook authenticity.
ADYEN_HMAC_KEY=

# CORS Configuration
CLIENT_URL=http://localhost:5173
