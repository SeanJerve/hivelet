# =============================================================================
# Hivelet — Environment Template
# Copy to .env at the repository root and fill in the real values.
# .env is gitignored; never commit it.
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co

# Public/browser key. Safe to publish by design — and after
# database/migrations/002_rbac_rls_lockdown.sql it can no longer read or write
# any table. The API keeps it only to health-check that the lockdown holds.
SUPABASE_ANON_KEY=your_anon_key_here

# SERVER-ONLY. Bypasses row level security entirely.
# Never expose this to the browser, never commit it, and rotate it if leaked.
# Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT Security Credentials
# Generate a unique secret before deploying: openssl rand -base64 48
# The API refuses to boot in production if this is left at the example value.
JWT_SECRET=change_me_before_deploying
JWT_EXPIRES_IN=7d

# Adyen GCash Payment Sandbox Credentials (Optional Feature)
ADYEN_API_KEY=your_adyen_api_key
ADYEN_MERCHANT_ACCOUNT=your_merchant_account
ADYEN_ENVIRONMENT=TEST

# CORS — website/ dev server runs on 5174, frontend/ wireframe basis on 5173
CLIENT_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
