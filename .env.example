# =============================================================================
# Hivelet - Environment Template
# Copy to .env at the repository root and fill in the real values.
# .env is gitignored; never commit it.
#
# THIS FILE MUST CONTAIN PLACEHOLDERS ONLY. NEVER A REAL VALUE.
#
# On 2026-09-13 this template was found to contain the LIVE Supabase
# service_role key, the live anon key, and the live JWT signing secret. They had
# been committed since 2026-08-25. All three must be treated as compromised and
# rotated; removing them from this file does not remove them from git history.
# =============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Supabase Configuration
# Project URL is not a secret, but the keys are. Find them in:
#   Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (sb_publishable_...). Safe in a browser when RLS is configured.
# Here it is locked down further still: it holds no grant on any table and can
# read nothing. Used only by the health check.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key (sb_secret_...). BYPASSES row-level security - it can read and write
# every row in every table. Server-only: it must never reach a browser, a frontend
# build, a screenshot, or this file.
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# The legacy JWT key names are still accepted as a fallback, but the legacy keys
# themselves were disabled on 2026-09-13 after being published in this file.

# NOTE: this template used to declare a MySQL database (DB_HOST, DB_PORT=3306,
# DB_USER, DB_NAME). Nothing reads those variables - a search of backend/src for
# any of them returns nothing, and the backend has no MySQL driver. They were
# left over from an abandoned stack, and a second database in the template
# implied an architecture this project does not have. Removed. The only database
# is Supabase PostgreSQL, configured above. See server/README.md.

# JWT Security Credentials
# Every access token in the system is signed with this. Anyone who knows it can
# mint a token claiming any role, which defeats the entire 39-permission RBAC
# model regardless of how correct that model is.
# Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=generate_a_random_48_byte_secret_do_not_use_a_phrase
JWT_EXPIRES_IN=7d

# Adyen — REQUIRED. This is the committed payment gateway, with GCash enabled.
#
# The test merchant account offers `scheme` (Cards) and `gcash` (GCash); confirm
# for yourself against Adyen's /v71/paymentMethods endpoint. Online payment is a
# real integration against Adyen's Checkout Sessions API, not a simulation.
#
# Find these in the Adyen Customer Area:
#   API key         Developers -> API credentials
#   Merchant account  top of the Customer Area, e.g. HiveletECOM
#   Client key      Developers -> API credentials -> Client key.
#                   Add your origin (http://localhost:5173) to its allowed origins
#                   or the Drop-in will refuse to load in the browser.
#
# WITHOUT these, isLiveConfigured() is false and a local development checkout page
# serves instead, so the system still runs on a machine with no Adyen account.
# That page is refused with 404 in any environment where Adyen IS configured: it
# writes a payment and is unauthenticated by necessity, so it must never stand
# alongside the real gateway.
ADYEN_API_KEY=your_adyen_test_api_key
ADYEN_MERCHANT_ACCOUNT=your_merchant_account
ADYEN_CLIENT_KEY=test_your_client_key
ADYEN_ENVIRONMENT=TEST

# --- Webhook (Customer Area -> Developers -> Webhooks -> Standard webhook) ----
#
# THE WEBHOOK IS THE ONLY THING THAT WRITES AN ONLINE PAYMENT. Without it,
# a tenant can complete a GCash payment at Adyen and nothing will ever appear in
# the ledger. It is not optional for the payment feature to work.
#
# The shopper's browser deliberately writes nothing on its return: Adyen Web v6
# passes it only seven keys and `pspReference` is not among them, so a row
# written there could never be reconciled against the webhook's and the same
# payment was banked twice. See services/adyenService.ts.
#
# Adyen cannot reach a machine on localhost. While developing, expose the API:
#   cloudflared tunnel --url http://localhost:5000
# then set the webhook URL to  <tunnel>/api/public/payments/adyen/webhook
# The tunnel address changes on every restart - update Adyen each time.
#
# HMAC key: click "Generate a new key" when creating the webhook, then paste the
# hex string here. Until this is a real key the webhook endpoint fails closed
# with 503 rather than pretending to work.
ADYEN_HMAC_KEY=your_hmac_key_hex_from_the_webhook_screen
#
# Basic Auth: optional but recommended by Adyen alongside HMAC. Set the SAME
# username and password in the webhook's "Basic authentication" section. Leave
# both blank to disable it - HMAC verification still applies either way.
ADYEN_WEBHOOK_USER=
ADYEN_WEBHOOK_PASSWORD=

# CORS. The Vue app in frontend/ runs on 5173 - that is the only client.
#
# This used to read "website/ dev server runs on 5174" with CLIENT_URL pointing
# there. That folder no longer exists (it appears in no commit in this
# repository), so the default client URL pointed at a port nothing listens on,
# and a cancelled checkout sent the payer to a dead address. 5174 is kept in the
# allow-list only so a second dev server on that port still works.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Whether POST /auth/register accepts anyone. OFF unless set to true.
#
# Nobody signs themselves up to live somewhere. The landlady admits a resident
# and POST /admin/tenants already does that - audited, behind a permission, with
# the unit and the move-in date attached. The sign-in screen dropped its
# "No account yet? Create one" link on 2026-09-19 for that reason, but removing
# the button did not close the endpoint: a profiles row inserted there carries
# role 'tenant' and account_status 'active', which puts a stranger straight into
# her Active Tenants list.
#
# Left as a setting rather than a deletion so the decision is reversible. Turn it
# on only if the property ever genuinely wants self-service sign-up.
ALLOW_PUBLIC_SIGNUP=false
