    PROFILES                     ||--o{ MAINTENANCE_TICKETS          : "raised_by"
    MAINTENANCE_TICKETS          ||--o{ TICKET_ATTACHMENTS           : "evidenced_by"
    MAINTENANCE_TICKETS          ||--o{ TICKET_MESSAGES              : "discussed_in"
