{
  "name": "hivelet",
  "version": "1.0.0",
  "private": true,
  "description": "Hivelet Web-Based Apartment Management System",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "verify:rbac": "node database/verify-rbac.mjs",
    "check:all": "node scripts/check-all.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "check:rules": "node scripts/check-br-crosswalk.mjs",
    "check:matrix": "node scripts/check-matrix-crosswalk.mjs",
    "check:copies": "node scripts/check-filming-copies.mjs",
    "refresh:copies": "node scripts/refresh-filming-copies.mjs",
    "check:canon": "node scripts/check-canon.mjs",
    "hooks:install": "git config core.hooksPath .githooks && echo \"pre-commit secret scanner installed\"",
    "backup": "node scripts/backup-database.mjs",
    "check:writes": "cd backend && npm run check:writes",
    "check:columns": "cd backend && npm run check:columns",
    "check:fields": "cd backend && npm run check:fields",
    "check:endpoints": "cd backend && npm run check:endpoints",
    "check:ledger": "cd backend && npm run check:ledger",
    "check:reports": "cd backend && npm run check:reports",
    "check:adyen": "cd backend && npm run check:adyen",
    "check:billing": "cd backend && npm run check:billing",
    "check:api": "cd backend && npm run check:api",
    "check:tokens": "cd frontend && npm run check:tokens",
    "check:reachable": "cd frontend && npm run check:reachable",
    "check:components": "cd frontend && npm run check:components",
    "check:liveness": "cd frontend && npm run check:liveness",
    "contract": "cd frontend && npm run contract",
    "measure": "cd backend && npm run measure"
  },
  "keywords": [
    "hivelet",
    "apartment-management",
    "vue3",
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "docx": "^9.7.1"
  }
}
